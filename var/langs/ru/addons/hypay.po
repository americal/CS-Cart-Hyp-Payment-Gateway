msgstr "Project-Id-Version: tygh\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language-Team: Russian\n"
"Language: ru_RU\n"

# Addon meta
msgctxt "Addons::name::hypay"
msgid "Hypay"
msgstr "Hypay"

msgctxt "Addons::description::hypay"
msgid "Hypay payment gateway for CS-Cart. Generates secure payment links via APISign and can auto-issue EzCount documents (integrated or direct API). Configure it under Administration → Payment methods: add or edit a method, choose Processor = “Hypay”, then open the processor settings."
msgstr "Платёжный шлюз Hypay для CS-Cart. Формирует защищённые платёжные ссылки через APISign и может автоматически выпускать документы EzCount (integrated или direct API). Настройки находятся в Администрирование → Способы оплаты: добавьте или откройте способ, выберите Процессор = «Hypay», затем откройте настройки процессора."

# Credentials / mode
msgctxt "Languages::hypay_masof"
msgid "Terminal (Masof)"
msgstr "Терминал (Masof)"

msgctxt "Languages::hypay_masof_desc"
msgid "10 digits. Numbers starting with 00100* are test terminals; others are live."
msgstr "10 цифр. Номера, начинающиеся с 00100*, — тестовые терминалы; остальные — рабочие."

msgctxt "Languages::hypay_api_key"
msgid "KEY (API key)"
msgstr "KEY (API-ключ)"

msgctxt "Languages::hypay_api_key_desc"
msgid "Your Hypay API KEY."
msgstr "Ваш API-ключ Hypay."

msgctxt "Languages::hypay_passp"
msgid "PassP"
msgstr "PassP"

msgctxt "Languages::hypay_passp_desc"
msgid "Secret PassP from Hypay backoffice."
msgstr "Секретный PassP из кабинета Hypay."

msgctxt "Languages::hypay_mode"
msgid "Mode"
msgstr "Режим"

msgctxt "Languages::hypay_mode_demo"
msgid "Demo (test)"
msgstr "Демо (тест)"

msgctxt "Languages::hypay_mode_live"
msgid "Live (production)"
msgstr "Боевой (production)"

msgctxt "Languages::hypay_mode_desc"
msgid "Choose test or live terminal."
msgstr "Выберите тестовый или боевой терминал."

# Return URL
msgctxt "Languages::hypay_return_url"
msgid "Success URL"
msgstr "Success URL"

msgctxt "Languages::hypay_return_url_desc"
msgid "Set this URL in Hypay dashboard as the payment success/return URL."
msgstr "Укажите этот адрес в кабинете Hypay как URL успешной оплаты/возврата."

# General params
msgctxt "Languages::hypay_info"
msgid "Transaction Info (Info)"
msgstr "Описание транзакции (Info)"

msgctxt "Languages::hypay_info_desc"
msgid "Template for the Info parameter. You can use {order_id}. Hyp echoes this text back in the return URL without encoding it, so #, &, ?, = and % are stripped before it is sent."
msgstr "Шаблон для параметра Info. Можно использовать {order_id}. Hyp возвращает этот текст в URL возврата без кодирования, поэтому символы #, &, ?, = и % вырезаются перед отправкой."

msgctxt "Languages::hypay_encoding_flags"
msgid "Encoding & signature"
msgstr "Кодировка и подпись"

msgctxt "Languages::hypay_encoding_flags_desc"
msgid "UTF8/UTF8out are recommended On. Sign depends on your terminal settings."
msgstr "Рекомендуется включить UTF8/UTF8out. Параметр Sign зависит от настроек терминала."

msgctxt "Languages::hypay_pagelang"
msgid "Payment page language"
msgstr "Язык платёжной страницы"

msgctxt "Languages::hypay_pagelang_auto"
msgid "Auto"
msgstr "Авто"

msgctxt "Languages::hypay_pagelang_desc"
msgid "Auto picks HEB for Hebrew, ENG for others. You can force ENG/HEB."
msgstr "Авто: HEB для иврита, ENG — для остальных. Можно принудительно выбрать ENG/HEB."

msgctxt "Languages::hypay_coin"
msgid "Currency (Coin)"
msgstr "Валюта (Coin)"

msgctxt "Languages::hypay_tmp"
msgid "Template (tmp)"
msgstr "Шаблон (tmp)"

msgctxt "Languages::hypay_tmp_desc"
msgid "Payment page template ID."
msgstr "ID шаблона платёжной страницы."

# Payments options
msgctxt "Languages::hypay_tash"
msgid "Max payments (Tash)"
msgstr "Максимум платежей (Tash)"

msgctxt "Languages::hypay_tash_desc"
msgid "Maximum number of installments the customer may choose."
msgstr "Максимальное число платежей (рассрочка), доступное покупателю."

msgctxt "Languages::hypay_tashtype"
msgid "Payment type (tashType)"
msgstr "Тип платежа (tashType)"

msgctxt "Languages::hypay_tashtype_desc"
msgid "1 — regular, 6 — credit (issuer must allow credit transactions)."
msgstr "1 — обычный, 6 — кредит (эмитент должен разрешать кредитные операции)."

msgctxt "Languages::hypay_fixtash"
msgid "FixTash (lock number of payments)"
msgstr "FixTash (зафиксировать число платежей)"

msgctxt "Languages::hypay_tash_first"
msgid "First payment amount"
msgstr "Первый платёж (сумма)"

msgctxt "Languages::hypay_tash_first_desc"
msgid "Leave empty if not used."
msgstr "Оставьте пустым, если не используется."

# Emails / UX / Risk
msgctxt "Languages::hypay_flags"
msgid "Emails / UX / Risk"
msgstr "Почта / UX / Риск"

msgctxt "Languages::hypay_ezcount_flags"
msgid "Ezcount settings"
msgstr "Настройки Ezcount"

msgctxt "Languages::hypay_ezcount_flags_desc"
msgid "Invoice delivery and items behaviour for Ezcount integration."
msgstr "Отправка счёта и поведение позиций для интеграции с Ezcount."

# Individual flags (labels)
msgctxt "Languages::hypay_label_sendemail"
msgid "sendemail (send payment confirmation)"
msgstr "sendemail (отправить подтверждение оплаты)"

msgctxt "Languages::hypay_label_moredata"
msgid "MoreData (return more data)"
msgstr "MoreData (возвращать больше данных)"

msgctxt "Languages::hypay_label_pagetimeout"
msgid "pageTimeOut (20-min timeout)"
msgstr "pageTimeOut (таймаут 20 минут)"

msgctxt "Languages::hypay_label_postpone"
msgid "Postpone (delayed transaction 800)"
msgstr "Postpone (отложенная транзакция 800)"

msgctxt "Languages::hypay_label_j5"
msgid "J5 (preserve credit line)"
msgstr "J5 (блокировать сумму на линии кредитования)"

msgctxt "Languages::hypay_label_show_eng_tash_text"
msgid "ShowEngTashText"
msgstr "ShowEngTashText (текст Tash на англ.)"

msgctxt "Languages::hypay_label_hide_btns"
msgid "hideBtns (hide wallet buttons)"
msgstr "hideBtns (скрыть кнопки кошельков)"

# Ezcount flags (labels)
msgctxt "Languages::hypay_label_sendhesh"
msgid "SendHesh (send invoice by email)"
msgstr "SendHesh (отправлять счёт по e-mail)"

msgctxt "Languages::hypay_label_pritim"
msgid "Pritim (invoice contains items)"
msgstr "Pritim (в счёте перечислены позиции)"

msgctxt "Languages::hypay_label_block_item_validation"
msgid "blockItemValidation (strict item totals)"
msgstr "blockItemValidation (строгая проверка сумм позиций)"

msgctxt "Languages::hypay_success_status"
msgid "Order status on success"
msgstr "Статус заказа при успехе"

msgctxt "Languages::hypay_success_status_desc"
msgid "Select which order status to set when Hypay reports a successful charge."
msgstr "Статус, который будет присвоен заказу при успешном платеже Hypay."

msgctxt "Languages::hypay_success_additional_status"
msgid "Additional status: successful payment"
msgstr "Доп. статус: успешная оплата"

msgctxt "Languages::hypay_success_additional_status_desc"
msgid "Additional order status to mark after an ordinary (J4) charge goes through and the order takes the status above. Left at \"do not change\", only the main order status moves — that is the default. Needs the [eCom Labs] Additional Order Statuses add-on: while it is disabled this selector is hidden and the stored choice is kept until it comes back."
msgstr "Дополнительный статус заказа, который проставится после успешной обычной оплаты (J4), когда заказ получит статус выше. При «не менять» трогается только основной статус — это значение по умолчанию. Требует аддон [eCom Labs] Additional Order Statuses: пока он отключён, список скрыт, а выбранное значение сохраняется до его возврата."

msgctxt "Languages::hypay_fail_status"
msgid "Order status on failure"
msgstr "Статус заказа при неудаче"

msgctxt "Languages::hypay_fail_status_desc"
msgid "Select which order status to set when Hypay fails or the request can't be signed."
msgstr "Статус, который будет присвоен заказу при неудачном платеже или ошибке SIGN."

msgctxt "Languages::hypay_building_field_id"
msgid "Building field ID"
msgstr "ID поля дома/корпуса"

msgctxt "Languages::hypay_building_field_id_desc"
msgid "Customer profile field ID that stores the building/house number. Leave empty if not used."
msgstr "ID пользовательского поля профиля, в котором хранится номер дома/корпуса. Оставьте пустым, если не используется."

msgctxt "Languages::hypay_debug_mode"
msgid "Debug mode"
msgstr "Режим отладки"

msgctxt "Languages::hypay_debug_mode_label"
msgid "Enable request/response logging to hypay_ezcount.log"
msgstr "Включить логирование запросов/ответов в hypay_ezcount.log"

msgctxt "Languages::hypay_debug_mode_desc"
msgid "When enabled, the processor writes detailed logs to the file below. Disable on production for performance and security."
msgstr "При включении процессор записывает подробные логи в файл ниже. На продакшене рекомендуется отключить из соображений производительности и безопасности."

msgctxt "Languages::hypay_ez_mode"
msgid "EzCount mode"
msgstr "Режим EzCount"

msgctxt "Languages::hypay_ez_mode_none"
msgid "Disabled"
msgstr "Выключено"

msgctxt "Languages::hypay_ez_mode_integrated"
msgid "Integrated (via Hypay)"
msgstr "Интегрированный (через Hypay)"

msgctxt "Languages::hypay_ez_mode_direct"
msgid "Direct API"
msgstr "Прямой API"

msgctxt "Languages::hypay_ez_mode_desc"
msgid "Choose how invoices are created: integrated (Hypay triggers EzCount) or direct (this add-on calls EzCount API). Choose Disabled to skip invoicing."
msgstr "Выберите способ выставления документов: интегрированный (Hypay создаёт документ в EzCount) или прямой (этот процессор вызывает API EzCount). «Выключено» — документы не создаются."

msgctxt "Languages::hypay_ez_doc_type"
msgid "Document type"
msgstr "Тип документа"

msgctxt "Languages::hypay_ez_doc_type_320"
msgid "Tax Invoice Receipt"
msgstr "Счёт-фактура-квитанция (320)"

msgctxt "Languages::hypay_ez_doc_type_400"
msgid "Receipt"
msgstr "Квитанция (400)"

msgctxt "Languages::hypay_ez_doc_type_desc"
msgid "320 — Tax Invoice Receipt, 400 — Receipt."
msgstr "320 — Tax Invoice Receipt, 400 — Receipt."

msgctxt "Languages::hypay_ez_created_by_api_key"
msgid "Created by API key (distributors)"
msgstr "Created by API key (для дистрибьюторов)"

msgctxt "Languages::hypay_ez_created_by_api_key_desc"
msgid "Optional. Use only if you create documents on behalf of multiple EZcount users. Send it as-is (do not hash). Leave empty to omit."
msgstr "Необязательно. Используйте только если вы создаёте документы от имени нескольких пользователей EZcount. Передавайте «как есть» (не хэшировать). Оставьте пустым, чтобы не отправлять."


msgctxt "Languages::hypay_ez_doc_lang"
msgid "Document language (lang)"
msgstr "Язык документа (lang)"

msgctxt "Languages::hypay_ez_doc_lang_desc"
msgid "he — иврит (по умолчанию), en — английский."
msgstr "he — иврит (по умолчанию), en — английский."

msgctxt "Languages::hypay_ez_line_items_mode"
msgid "Document line items: regular deals"
msgstr "Состав документа: обычные сделки"

msgctxt "Languages::hypay_ez_line_items_mode_products"
msgid "List products"
msgstr "Расписывать товары"

msgctxt "Languages::hypay_ez_line_items_mode_orders"
msgid "Order number only"
msgstr "Только номер заказа"

msgctxt "Languages::hypay_ez_line_items_mode_desc"
msgid "How a document issued at regular checkout is itemized. List products: a line per product plus shipping, payment surcharge, discounts and the rounding adjustment. Order number only: a single line reading Order #1234, priced at the order total."
msgstr "Чем заполняется документ, выписанный при обычной оплате. Расписывать товары: строка на каждый товар плюс доставка, комиссия, скидки и округление. Только номер заказа: одна строка вида Order #1234 на всю сумму заказа."

msgctxt "Languages::hypay_ez_line_items_mode_j5"
msgid "Document line items: J5 (after capture)"
msgstr "Состав документа: сделки J5 (после списания)"

msgctxt "Languages::hypay_ez_line_items_mode_j5_inherit"
msgid "Same as regular deals"
msgstr "Как для обычных сделок"

msgctxt "Languages::hypay_ez_line_items_mode_j5_desc"
msgid "The same choice for the document issued when a J5 authorization is captured, days after checkout. Left at \"same as regular deals\" it follows the setting above, so an install that had one setting keeps behaving as it did."
msgstr "То же самое для документа, который выписывается при списании J5-авторизации — уже после оформления заказа. При значении «как для обычных сделок» берётся настройка выше, поэтому там, где была одна настройка, поведение не меняется."

msgctxt "Languages::hypay_ez_show_items_including_vat"
msgid "Show items including VAT"
msgstr "Показывать позиции с НДС"

msgctxt "Languages::hypay_ez_show_items_including_vat_label"
msgid "Send item prices as VAT-inclusive (1 = on, 0 = off)"
msgstr "Отправлять цены позиций с учётом НДС (1 — да, 0 — нет)"

msgctxt "Languages::hypay_ez_show_items_including_vat_desc"
msgid "When enabled, the API receives show_items_including_vat=1. Disable to send 0."
msgstr "Если включено — в API уходит show_items_including_vat=1. Отключите, чтобы отправлять 0."

msgctxt "Languages::hypay_ez_auto_calc_payments"
msgid "Auto-calc payments"
msgstr "Auto-calc payments"

msgctxt "Languages::hypay_ez_auto_calc_payments_label"
msgid "Let EzCount calculate installment schedule (1 = on, 0 = off)"
msgstr "Let EzCount calculate installment schedule (1 = on, 0 = off)"

msgctxt "Languages::hypay_ez_auto_calc_payments_desc"
msgid "When enabled, the request sends auto_calc_payments=1 in the payment block."
msgstr "When enabled, the request sends auto_calc_payments=1 in the payment block."

# J5 (two-phase commit)
msgctxt "Languages::hypay_j5_section"
msgid "J5 / Two-phase commit"
msgstr "J5 / Двухфазный платёж"

msgctxt "Languages::hypay_payment_type"
msgid "Payment type"
msgstr "Тип платежа"

msgctxt "Languages::hypay_payment_type_desc"
msgid "Regular: the card is charged immediately. J5: the funds are only held and are charged later from the order page. By usergroup: J5 is used for the usergroups selected below, everybody else pays as usual."
msgstr "Обычный: деньги списываются сразу. J5: средства только удерживаются, списание — вручную из карточки заказа. По группам: J5 применяется к выбранным ниже группам, остальные платят как раньше."

msgctxt "Languages::hypay_payment_type_regular"
msgid "Regular charge (J4)"
msgstr "Обычное списание (J4)"

msgctxt "Languages::hypay_payment_type_j5"
msgid "Hold funds (J5) for everyone"
msgstr "Удержание (J5) для всех"

msgctxt "Languages::hypay_payment_type_usergroup"
msgid "Hold funds (J5) by usergroup"
msgstr "Удержание (J5) по группам пользователей"

msgctxt "Languages::hypay_j5_usergroups"
msgid "Usergroups paying with J5"
msgstr "Группы, которые платят через J5"

msgctxt "Languages::hypay_j5_usergroups_desc"
msgid "Used only when the payment type is \"Hold funds (J5) by usergroup\". A customer belonging to any of the selected groups gets a J5 authorization instead of a charge. Reset selected clears the list in the form and takes effect once the method is saved; an empty list means nobody gets a hold and every customer is charged at checkout."
msgstr "Используется только при типе оплаты «Удерживать средства (J5) по группам». Покупатель из любой выбранной группы получает J5-авторизацию вместо списания. «Сбросить выбранные» снимает выделение в форме и вступает в силу после сохранения способа оплаты; пустой список означает, что удержание не получит никто — все платят как обычно."

msgctxt "Languages::hypay_j5_usergroups_reset"
msgid "Reset selected"
msgstr "Сбросить выбранные"

msgctxt "Languages::hypay_j5_usergroups_empty"
msgid "Usergroup list is unavailable. Save the payment method and reopen this page."
msgstr "Список групп недоступен. Сохраните метод оплаты и откройте страницу заново."

msgctxt "Languages::hypay_j5_auth_status"
msgid "Order status: funds held"
msgstr "Статус заказа: средства удержаны"

msgctxt "Languages::hypay_j5_auth_status_desc"
msgid "Set right after a successful J5 authorization, while the money is only held."
msgstr "Устанавливается сразу после успешной авторизации J5, пока деньги только удержаны."

msgctxt "Languages::hypay_j5_captured_status"
msgid "Order status: captured"
msgstr "Статус заказа: средства списаны"

msgctxt "Languages::hypay_j5_captured_status_desc"
msgid "Set after the held amount has been charged."
msgstr "Устанавливается после фактического списания удержанной суммы."

msgctxt "Languages::hypay_j5_auth_additional_status"
msgid "Additional status: funds held"
msgstr "Доп. статус: средства удержаны"

msgctxt "Languages::hypay_j5_auth_additional_status_desc"
msgid "Additional order status to mark once Hyp confirms the hold and the order takes the status above. Left at \"do not change\", only the main order status moves. Needs the [eCom Labs] Additional Order Statuses add-on: while it is disabled both of these selectors are hidden and the stored choices are kept until it comes back."
msgstr "Дополнительный статус заказа, который проставится, когда Hyp подтвердит удержание и заказ получит статус выше. При «не менять» трогается только основной статус. Требует аддон [eCom Labs] Additional Order Statuses: пока он отключён, оба этих списка скрыты, а выбранные значения сохраняются до его возврата."

msgctxt "Languages::hypay_additional_status_none"
msgid "— do not change —"
msgstr "— не менять —"

msgctxt "Languages::hypay_j5_captured_additional_status"
msgid "Additional status: captured"
msgstr "Доп. статус: средства списаны"

msgctxt "Languages::hypay_j5_captured_additional_status_desc"
msgid "Additional order status to mark once the held amount has been charged. Left at \"do not change\", only the main order status moves. Needs the [eCom Labs] Additional Order Statuses add-on: while it is disabled both of these selectors are hidden and the stored choices are kept until it comes back."
msgstr "Дополнительный статус заказа, который проставится после списания удержанной суммы. При «не менять» трогается только основной статус. Требует аддон [eCom Labs] Additional Order Statuses: пока он отключён, оба этих списка скрыты, а выбранные значения сохраняются до его возврата."

msgctxt "Languages::hypay_j5_void_status"
msgid "Order status: hold cancelled"
msgstr "Статус заказа: удержание отменено"

msgctxt "Languages::hypay_j5_void_status_desc"
msgid "Set when the hold is abandoned and no money is taken."
msgstr "Устанавливается при отмене удержания, когда деньги не списываются."

msgctxt "Languages::hypay_j5_hold_days"
msgid "Authorization window, days"
msgstr "Срок удержания, дней"

msgctxt "Languages::hypay_j5_hold_days_desc"
msgid "How long the issuer keeps the funds blocked (Hyp: about 5 days). Used to show the capture deadline on the order page."
msgstr "Сколько дней банк держит средства заблокированными (по докам Hyp — около 5). Используется для показа дедлайна списания в заказе."

msgctxt "Languages::hypay_j5_title"
msgid "J5 hold (two-phase commit)"
msgstr "Удержание J5 (двухфазный платёж)"

msgctxt "Languages::hypay_j5_status"
msgid "Hold status"
msgstr "Статус удержания"

msgctxt "Languages::hypay_j5_status_authorized"
msgid "Authorized — awaiting capture"
msgstr "Авторизовано — ожидает списания"

msgctxt "Languages::hypay_j5_status_capturing"
msgid "Capture in progress"
msgstr "Списание выполняется"

msgctxt "Languages::hypay_j5_status_captured"
msgid "Captured"
msgstr "Списано"

msgctxt "Languages::hypay_j5_status_voided"
msgid "Hold cancelled"
msgstr "Удержание отменено"

msgctxt "Languages::hypay_j5_authorized_amount"
msgid "Authorized amount"
msgstr "Авторизованная сумма"

msgctxt "Languages::hypay_j5_auth_number"
msgid "Authorization number"
msgstr "Код авторизации"

msgctxt "Languages::hypay_j5_auth_number_new"
msgid "New authorization number"
msgstr "Новый код авторизации"

msgctxt "Languages::hypay_j5_auth_number_refused"
msgid "The capture was refused with the authorization number this hold carries. If the credit company issued a new approval number, enter it here and capture again."
msgstr "Списание было отклонено с кодом авторизации, полученным для этого холда. Если кредитная компания выдала новый код разрешения, введите его здесь и повторите списание."

msgctxt "Languages::hypay_j5_auth_number_new_desc"
msgid "The authorization number the capture sends back to Shva. It comes back with the hold, but a capture the credit company refused can be retried with a fresh approval number obtained from them by phone. Leave it empty to keep the number shown here. Digits only."
msgstr "Код авторизации, который списание передаёт в Shva. Он приходит вместе с холдом, но списание, отклонённое кредитной компанией, можно повторить с новым кодом разрешения, полученным у неё по телефону. Оставьте поле пустым, чтобы использовать показанный код. Только цифры."

msgctxt "Languages::hypay_j5_auth_number_new_desc_short"
msgid "Enter a new approval number from the credit company, or leave empty to reuse the current one."
msgstr "Введите новый код разрешения от кредитной компании или оставьте пустым, чтобы использовать текущий."

msgctxt "Languages::hypay_j5_error_bad_acode"
msgid "That is not a usable authorization number. It should be the digits of the approval the credit company gave you."
msgstr "Это недопустимый код авторизации. Введите цифры разрешения, которое выдала кредитная компания."

msgctxt "Languages::hypay_j5_expires_at"
msgid "Capture before"
msgstr "Списать до"

msgctxt "Languages::hypay_j5_expired"
msgid "the authorization window has passed, the capture may be declined"
msgstr "срок удержания истёк, списание может быть отклонено"

msgctxt "Languages::hypay_j5_delta_vs_hold"
msgid "against the hold"
msgstr "относительно удержания"

msgctxt "Languages::hypay_j5_order_total"
msgid "Amount to capture (order total)"
msgstr "К списанию (итог заказа)"

msgctxt "Languages::hypay_j5_captured_amount"
msgid "Captured amount"
msgstr "Списанная сумма"

msgctxt "Languages::hypay_j5_capture_transaction"
msgid "Capture transaction ID"
msgstr "ID транзакции списания"

msgctxt "Languages::hypay_j5_voided_at"
msgid "Cancelled at"
msgstr "Отменено"

msgctxt "Languages::hypay_j5_warning_total_above_hold"
msgid "The order total is higher than the authorized amount. Only an amount up to the hold can be captured — reduce the order or ask the customer to pay again."
msgstr "Итог заказа больше удержанной суммы. Списать можно не больше удержания — уменьшите заказ или запросите новую оплату."

msgctxt "Languages::hypay_j5_notice_partial_capture"
msgid "The order total is lower than the authorized amount: only the order total will be captured."
msgstr "Итог заказа меньше удержанной суммы: спишется именно итог заказа."

msgctxt "Languages::hypay_j5_warning_no_token"
msgid "The card token is missing; it will be requested again during the capture."
msgstr "Токен карты не получен — он будет запрошен повторно при списании."

msgctxt "Languages::hypay_j5_btn_capture"
msgid "Capture"
msgstr "Списать"

msgctxt "Languages::hypay_j5_btn_void"
msgid "Cancel hold"
msgstr "Отменить удержание"

msgctxt "Languages::hypay_j5_confirm_capture"
msgid "Charge the customer for the order total?"
msgstr "Списать с покупателя сумму заказа?"

msgctxt "Languages::hypay_j5_confirm_void"
msgid "Cancel the hold? The money will not be taken."
msgstr "Отменить удержание? Деньги списаны не будут."

msgctxt "Languages::hypay_j5_actions_hint_short"
msgid "Capture charges the current order total."
msgstr "Списывается текущий итог заказа."

msgctxt "Languages::hypay_j5_actions_hint"
msgid "To capture a smaller amount, edit the order first: the capture always uses the current order total, so the EzCount document matches the money actually taken."
msgstr "Чтобы списать меньшую сумму, сначала отредактируйте заказ: списывается всегда текущий итог заказа, поэтому документ EzCount совпадает с фактически списанными деньгами."

msgctxt "Languages::hypay_j5_error_no_order"
msgid "Order not found."
msgstr "Заказ не найден."

msgctxt "Languages::hypay_j5_error_not_authorized"
msgid "This order has no J5 hold awaiting capture."
msgstr "По этому заказу нет удержания J5, ожидающего списания."

msgctxt "Languages::hypay_j5_error_zero_amount"
msgid "The capture amount must be greater than zero."
msgstr "Сумма списания должна быть больше нуля."

msgctxt "Languages::hypay_j5_error_exceeds_authorized"
msgid "The capture amount is higher than the authorized amount."
msgstr "Сумма списания больше авторизованной суммы."

msgctxt "Languages::hypay_j5_error_amount_mismatch"
msgid "The capture amount must be equal to the order total. Edit the order first, then capture."
msgstr "Сумма списания должна совпадать с итогом заказа. Сначала отредактируйте заказ, затем списывайте."

msgctxt "Languages::hypay_j5_error_in_progress"
msgid "This hold is already being processed."
msgstr "Это удержание уже обрабатывается."

msgctxt "Languages::hypay_j5_error_no_token"
msgid "Could not get the card token from Hyp:"
msgstr "Не удалось получить токен карты от Hyp:"

msgctxt "Languages::hypay_j5_error_bad_tokef"
msgid "Hyp returned an unreadable card expiry (Tokef=[tokef])."
msgstr "Hyp вернул нечитаемый срок действия карты (Tokef=[tokef])."

msgctxt "Languages::hypay_j5_capture_failed"
msgid "Hyp declined the capture:"
msgstr "Hyp отклонил списание:"

msgctxt "Languages::hypay_j5_capture_ok"
msgid "Captured [amount] from the J5 hold."
msgstr "Списано [amount] из удержания J5."

msgctxt "Languages::hypay_j5_void_ok"
msgid "The hold was cancelled. The issuer releases the funds within about [days] days."
msgstr "Удержание отменено. Банк освободит средства примерно в течение [days] дн."

msgctxt "Languages::hypay_j5_pi_authorized"
msgid "J5 hold [amount] — awaiting capture"
msgstr "Удержание J5 [amount] — ожидает списания"

msgctxt "Languages::hypay_j5_pi_personal_id_original"
msgid "[id] (Original: [original])"
msgstr "[id] (Original: [original])"

msgctxt "Languages::hypay_j5_pi_captured"
msgid "J5 captured [amount]"
msgstr "J5: списано [amount]"

msgctxt "Languages::hypay_j5_pi_voided"
msgid "J5 hold cancelled — not charged"
msgstr "Удержание J5 отменено — списания не было"

msgctxt "Languages::hypay_j5_note_captured"
msgid "Hypay J5: captured [amount], transaction [id]"
msgstr "Hypay J5: списано [amount], транзакция [id]"

msgctxt "Languages::hypay_j5_note_voided"
msgid "Hypay J5: hold cancelled, no money was taken"
msgstr "Hypay J5: удержание отменено, деньги не списаны"

msgctxt "Languages::hypay_ez_amount_mismatch"
msgid "EzCount document was not issued: the order lines add up to [items] but [charged] was charged. Edit the order so the totals match."
msgstr "Документ EzCount не создан: позиции заказа дают [items], а списано [charged]. Отредактируйте заказ, чтобы суммы совпали."

msgctxt "Languages::hypay_j5"
msgid "J5 hold"
msgstr "Удержание J5"

msgctxt "Languages::hypay_j5_pi_hold_until"
msgid "[amount] held, capture before [date]"
msgstr "[amount] удержано, списать до [date]"

msgctxt "Languages::hypay_j5_pi_captured_on"
msgid "[amount] captured on [date], [payments] payment(s)"
msgstr "[amount] списано [date], платежей: [payments]"

msgctxt "Languages::hypay_j5_capture_unknown"
msgid "Hyp did not return a readable answer to the capture request. The hold is left locked: check the transaction in the Hyp control panel before trying again."
msgstr "Hyp не вернул читаемого ответа на запрос списания. Удержание оставлено заблокированным: проверьте транзакцию в панели Hyp, прежде чем повторять."

msgctxt "Languages::hypay_j5_stuck_capturing"
msgid "A capture was sent but the answer never arrived. Check the transaction in the Hyp control panel: if it was charged, no further action is needed; if it was not, the hold can be released from here after the state is corrected in the database."
msgstr "Запрос на списание был отправлен, но ответ не получен. Проверьте транзакцию в панели Hyp: если списание прошло — ничего делать не нужно; если нет — состояние нужно поправить в БД, после чего удержание снова станет доступным."

msgctxt "Languages::hypay_j5_payments"
msgid "Payments"
msgstr "Платежей"

msgctxt "Languages::hypay_j5_payments_desc"
msgid "Number of instalments the capture is charged in."
msgstr "В скольких платежах будет списана сумма."

msgctxt "Languages::hypay_j5_personal_id"
msgid "Cardholder's ID"
msgstr "Удостоверение личности держателя карты"

msgctxt "Languages::hypay_j5_personal_id_unknown"
msgid "Not supplied"
msgstr "Не указано"

msgctxt "Languages::hypay_j5_personal_id_desc"
msgid "Israeli ID of the cardholder, checked for a valid check digit before the capture is sent. The payment page does not always ask for one, and a Direct (debit) card is charged only when the ID matches the account it is drawn on. Anything that is not a real ID goes out as 000000000, which tells the issuer none was supplied."
msgstr "Израильский номер удостоверения держателя карты, перед отправкой списания проверяется по контрольной цифре. Платёжная страница запрашивает его не всегда, а дебетовая карта Direct списывается только при совпадении с владельцем счёта. Всё, что не является настоящим номером, уходит как 000000000 — это сообщает эмитенту, что удостоверение не предъявлено."

msgctxt "Languages::hypay_j5_personal_id_refused"
msgid "The capture was refused over the ID or the CVV. A token charge carries no CVV, so fill in the cardholder's Israeli ID here and capture again."
msgstr "Списание отклонено из-за удостоверения личности или CVV. Списание по токену CVV не передаёт, поэтому укажите здесь номер удостоверения держателя карты и повторите списание."

msgctxt "Languages::hypay_j5_warning_bad_personal_id"
msgid "That is not a valid Israeli ID: nine digits, left-padded with zeros, the last of them a check digit computed from the other eight. The capture was sent without an ID."
msgstr "Это не корректный израильский номер удостоверения: девять цифр, дополненных нулями слева, последняя из них — контрольная, вычисляемая по остальным восьми. Списание отправлено без номера удостоверения."

msgctxt "Languages::hypay_j5_error_payments_range"
msgid "The number of payments must be between 1 and [max]."
msgstr "Количество платежей должно быть от 1 до [max]."

msgctxt "Languages::hypay_j5_error_missing_auth_data"
msgid "The authorization is missing data required for the capture ([fields]). Check that MoreData=True is sent with the payment request."
msgstr "В авторизации нет данных, необходимых для списания ([fields]). Проверьте, что запрос отправляется с MoreData=True."

msgctxt "Languages::hypay_j5_pi_voided_on"
msgid "[amount] hold released on [date]"
msgstr "Удержание [amount] снято [date]"

msgctxt "Languages::hypay_j5_warning_no_uid"
msgid "Hyp did not return UID with the authorization, so this hold cannot be captured. This almost always means the return URL was cut short: Hyp echoes Info, ClientName, street and city back unencoded, and a \"#\" in any of them turns the rest of the URL into a fragment the browser never sends. Enable debug mode and look at query_string in hypay_ezcount.log to see where it stopped."
msgstr "Hyp не вернул UID вместе с авторизацией — списать это удержание не получится. Почти всегда причина в том, что URL возврата обрезан: Hyp подставляет Info, ClientName, street и city обратно без кодирования, и «#» в любом из них превращает остаток URL во фрагмент, который браузер на сервер не отправляет. Включите debug-режим и посмотрите query_string в hypay_ezcount.log — там видно, на чём обрыв."

msgctxt "Languages::hypay_j5_pi_voided_confirmed"
msgid "J5 hold cancelled on Hyp — not charged"
msgstr "Удержание J5 отменено на стороне Hyp — списания не было"

msgctxt "Languages::hypay_j5_note_voided_confirmed"
msgid "Hypay J5: cancelled via CancelTrans, Hyp confirmed the funds were released"
msgstr "Hypay J5: удержание отменено через CancelTrans, Hyp подтвердил освобождение средств"

msgctxt "Languages::hypay_j5_note_voided_unconfirmed"
msgid "Hypay J5: hold marked cancelled locally, Hyp did not confirm it ([detail]). The issuer releases the funds when the authorization window expires."
msgstr "Hypay J5: удержание отменено локально, Hyp не подтвердил отмену ([detail]). Банк освободит средства по истечении срока удержания."

msgctxt "Languages::hypay_j5_void_ok_confirmed"
msgid "Hyp confirmed the hold was cancelled — the funds were released immediately."
msgstr "Hyp подтвердил отмену удержания — средства освобождены сразу."

msgctxt "Languages::hypay_j5_void_ok_unconfirmed"
msgid "The hold was cancelled locally, but Hyp could not confirm the cancellation (it may already be near its authorization window). The issuer releases the funds within about [days] days."
msgstr "Удержание отменено локально, но Hyp не подтвердил отмену (возможно, срок удержания уже истекает). Банк освободит средства примерно в течение [days] дн."

msgctxt "Languages::hypay_j5_void_not_confirmed_hint"
msgid "Hyp did not confirm this cancellation through CancelTrans (shown below). The hold is treated as abandoned on our side either way and will never be captured; the issuer releases the funds when the authorization window expires."
msgstr "Hyp не подтвердил отмену через CancelTrans (текст ниже). Удержание в любом случае считается отменённым с нашей стороны и списано не будет; банк освободит средства по истечении срока удержания."

msgctxt "Languages::hypay_j5_working"
msgid "Contacting Hyp, please wait…"
msgstr "Обращаемся к Hyp, подождите…"

msgctxt "Languages::hypay_j5_uid"
msgid "Shva UID"
msgstr "Shva UID"

msgctxt "Languages::hypay_j5_void_ok_not_cancellable"
msgid "The hold will not be captured. Hyp refused to reverse it, so the issuer releases the funds when the authorization window ends, within about [days] days."
msgstr "Удержание списано не будет. Hyp отклонил его снятие, поэтому банк освободит средства по окончании срока удержания — примерно за [days] дн."

msgctxt "Languages::hypay_j5_note_voided_not_cancellable"
msgid "Hypay J5: hold cancelled here, Hyp refused to reverse it on its side; the issuer releases the funds when the authorization window ends."
msgstr "Hypay J5: удержание отменено у нас, Hyp отклонил снятие на своей стороне; банк освободит средства по окончании срока удержания."

msgctxt "Languages::hypay_j5_void_not_cancellable_hint"
msgid "Hyp refused to reverse this hold — its answer is below. Nothing was charged and the hold can never be captured; the issuer releases the funds when the authorization window ends, within about [days] days."
msgstr "Hyp отклонил снятие этого удержания — его ответ ниже. Деньги не списаны, списать удержание уже нельзя; банк освободит средства по окончании срока удержания, примерно за [days] дн."

msgctxt "Languages::hypay_j5_void_ok_instalments"
msgid "The hold will not be captured. Hyp does not reverse a hold taken in instalments, so the issuer releases the funds when the authorization window ends, within about [days] days."
msgstr "Удержание списано не будет. Hyp не снимает удержание, взятое в рассрочку, поэтому банк освободит средства по окончании срока — примерно за [days] дн."

msgctxt "Languages::hypay_j5_note_voided_instalments"
msgid "Hypay J5: hold cancelled here. Hyp does not reverse a hold taken in instalments, so the issuer releases the funds when the authorization window ends."
msgstr "Hypay J5: удержание отменено у нас. Hyp не снимает удержание, взятое в рассрочку, поэтому банк освободит средства по окончании срока удержания."

msgctxt "Languages::hypay_j5_void_instalments_hint"
msgid "This hold was taken in instalments, and Hyp does not reverse those through CancelTrans - a single-payment hold is released immediately, an instalment one is refused whatever payment details the request carries. Nothing was charged and the hold can never be captured; the issuer releases the funds when the authorization window ends, within about [days] days."
msgstr "Это удержание взято в рассрочку, а такие Hyp через CancelTrans не снимает — удержание в один платёж освобождается сразу, а в рассрочку отклоняется при любых переданных данных о платежах. Деньги не списаны, списать удержание уже нельзя; банк освободит средства по окончании срока, примерно за [days] дн."

msgctxt "Languages::hypay_j5_void_instalments_notice_short"
msgid "An instalment hold is not released early."
msgstr "Удержание в рассрочку не освобождается досрочно."

msgctxt "Languages::hypay_j5_void_instalments_notice"
msgid "Cancelling: this hold was taken in more than one payment, and Hyp does not release those early — cancelling still guarantees it is never captured, but the funds stay held until the authorization window ends, within about [days] days. A single-payment hold is released immediately."
msgstr "К отмене: это удержание взято более чем в один платёж, а такие Hyp досрочно не освобождает — отмена по-прежнему гарантирует, что списания не будет, но деньги останутся удержаны до окончания срока, примерно [days] дн. Удержание в один платёж освобождается сразу."

msgctxt "Languages::hypay_j5_hide_btns"
msgid "hideBtns for J5"
msgstr "hideBtns для J5"

msgctxt "Languages::hypay_j5_hide_btns_inherit"
msgid "Same as a regular charge"
msgstr "Как при обычном списании"

msgctxt "Languages::hypay_j5_hide_btns_on"
msgid "On — hide the buttons"
msgstr "Включено — скрывать кнопки"

msgctxt "Languages::hypay_j5_hide_btns_off"
msgid "Off — show the buttons"
msgstr "Выключено — показывать кнопки"

msgctxt "Languages::hypay_j5_hide_btns_desc"
msgid "Overrides the hideBtns checkbox above for J5 authorizations only, so a hold can show different buttons on the payment page than a charge. Leave it on \"Same as a regular charge\" to keep using the checkbox."
msgstr "Переопределяет флажок hideBtns выше только для авторизаций J5 — чтобы на странице оплаты удержание показывало не те кнопки, что списание. Оставьте «Как при обычном списании», чтобы продолжал действовать флажок."

msgctxt "Languages::hypay_ez_ua_uuid_j5"
msgid "UA UUID for J5 documents"
msgstr "UA UUID для документов J5"

msgctxt "Languages::hypay_ez_ua_uuid_j5_desc"
msgid "Used for the document issued after a J5 capture, instead of the UA UUID above. This field does not fall back to it: leave it empty and J5 documents are created without ua_uuid at all, even when the field above is filled in."
msgstr "Используется для документа, который создаётся после списания J5, вместо UA UUID выше. Это поле не наследует его значение: если оставить пустым, документы J5 будут создаваться вообще без ua_uuid, даже когда поле выше заполнено."



msgctxt "Languages::hypay_j5_capture_fallback_also_refused"
msgid "the ordinary charge that followed was refused too:"
msgstr "последовавшее обычное списание тоже отклонено:"

msgctxt "Languages::hypay_j5_captured_by_fallback"
msgid "The capture was refused, so the amount was charged as a separate transaction on the saved card."
msgstr "Capture был отклонён, поэтому сумма списана отдельной сделкой по сохранённой карте."

msgctxt "Languages::hypay_j5_fallback_hold_released"
msgid "The hold was reversed with it, and drops off the card straight away."
msgstr "Удержание отменено вместе с ней и сразу снимается с карты."

msgctxt "Languages::hypay_j5_fallback_hold_stays"
msgid "The hold could not be reversed - it is only cancellable on the day it was taken. It is never captured now, and the issuer releases it within [days] days."
msgstr "Удержание отменить не удалось — оно отменяется только в день, когда было сделано. Списать его уже нельзя, эмитент освободит средства в течение [days] дн."

msgctxt "Languages::hypay_j5_note_fallback_released"
msgid "The capture was refused by the acquirer; the amount was charged as a separate transaction and the hold was reversed."
msgstr "Capture отклонён эквайером; сумма списана отдельной сделкой, удержание отменено."

msgctxt "Languages::hypay_j5_note_fallback_hold_stays"
msgid "The capture was refused by the acquirer; the amount was charged as a separate transaction. The hold could not be reversed and is released by the issuer within [days] days."
msgstr "Capture отклонён эквайером; сумма списана отдельной сделкой. Удержание отменить не удалось, эмитент освободит средства в течение [days] дн."

msgctxt "Languages::hypay_j5_capture_fallback"
msgid "Refused capture"
msgstr "Отклонённый capture"

msgctxt "Languages::hypay_j5_capture_fallback_label"
msgid "Charge the saved card when the capture is refused"
msgstr "Списывать с сохранённой карты, когда capture отклонён"

msgctxt "Languages::hypay_j5_capture_fallback_desc"
msgid "An immediate-debit (Direct) card refuses a capture that carries the hold's authorization number (CCode 512, 455, 445). With this on, the amount is then charged as an ordinary transaction on the saved card, and the hold is reversed if it still can be - so the order is paid instead of stuck. Switch it off to have the refusal reported and nothing charged."
msgstr "Карта немедленного дебета (Direct) отклоняет capture, несущий номер авторизации удержания (CCode 512, 455, 445). Если включено, сумма после этого списывается обычной сделкой по сохранённой карте, а удержание отменяется, если это ещё возможно — заказ оказывается оплачен, а не заблокирован. Выключите, чтобы отказ просто показывался и ничего не списывалось."


msgctxt "Languages::hypay_j5_personal_id_desc_short"
msgid "Sent with the capture, checked before it goes out."
msgstr "Уходит вместе с capture, проверяется перед отправкой."

msgctxt "Languages::hypay_j5_personal_id_bad"
msgid "Not a valid Israeli ID — the check digit does not match. Capture as it stands and 000000000 is sent instead."
msgstr "Это не действительный ת.ז — контрольная цифра не сходится. Если списать как есть, уйдёт 000000000."

msgctxt "Languages::hypay_j5_immediate_amount_locked"
msgid "This is an immediate-debit card, so the charge is pinned to the amount the customer approved and the order total cannot be changed before capturing."
msgstr "Это карта немедленного дебета, поэтому сумма списания закреплена за той, на которую дал согласие клиент: менять итог заказа перед списанием нельзя."

msgctxt "Languages::hypay_j5_immediate_amount_locked_blocked"
msgid "The order total no longer matches the hold, and on an immediate-debit card it must: the charge is a fresh sale on the saved card rather than a capture, so it can only be made for the amount the customer approved. Restore the order total to capture."
msgstr "Итог заказа больше не совпадает с удержанием, а на карте немедленного дебета он совпадать обязан: списание здесь — не подтверждение удержания, а новая продажа по сохранённой карте, и провести её можно только на сумму, на которую дал согласие клиент. Верните прежний итог заказа, чтобы списать."

msgctxt "Languages::hypay_j5_error_immediate_amount_locked"
msgid "This is an immediate-debit card: the charge can only be made for the amount the customer approved, [amount]. Restore the order total and capture again."
msgstr "Это карта немедленного дебета: списать можно только сумму, на которую дал согласие клиент — [amount]. Верните прежний итог заказа и повторите списание."

msgctxt "Languages::hypay_card"
msgid "Card"
msgstr "Карта"


msgctxt "Languages::hypay_ez_customer_name"
msgid "EzCount name"
msgstr "Имя в EzCount"

msgctxt "Languages::hypay_ez_customer_name_label"
msgid "Use the customer's EzCount name instead of the profile name"
msgstr "Использовать имя клиента в EzCount вместо имени профиля"

msgctxt "Languages::hypay_ez_customer_name_desc"
msgid "Names the document after the customer's EzCount name - the profile \"Fax\" field, the same one the EzCount Invoice Generator add-on reads. A customer who never filled it in is still named on the document, by their profile name."
msgstr "Документ выписывается на имя клиента в EzCount - поле профиля \"Факс\", то же, которое читает модуль EzCount Invoice Generator. Если клиент его не заполнил, документ всё равно выписывается на имя из профиля."

msgctxt "Languages::hypay_ez_customer_vat"
msgid "VAT ID"
msgstr "VAT ID"

msgctxt "Languages::hypay_ez_customer_vat_label"
msgid "Send the customer's VAT ID"
msgstr "Передавать VAT ID клиента"

msgctxt "Languages::hypay_ez_customer_vat_desc"
msgid "Sends the VAT ID from the profile \"URL\" field as customer_crn, so the document is made out to the company rather than to a private buyer."
msgstr "Передаёт VAT ID из поля профиля \"URL\" как customer_crn, и документ выписывается на компанию, а не на частное лицо."

msgctxt "Languages::hypay_ez_int_customer_vat_desc"
msgid "Sends the VAT ID from the profile \"URL\" field to Hyp as UserId, which is the number the document it issues is filed under. It is never sent with a J5 authorization: UserId there is the cardholder ID Shva checks the later capture against, and a company number is not that."
msgstr "Передаёт VAT ID из поля профиля \"URL\" в Hyp как UserId - номер, под которым выписывается созданный им документ. С авторизацией J5 не передаётся никогда: там UserId - это удостоверение держателя карты, по которому Shva проверяет последующее списание, а номер компании им не является."

msgctxt "Languages::hypay_ez_int_customer_limits"
msgid "Only these two travel with a payment request. The EzCount CC e-mail and filing the document under an existing customer card are set on the document itself, which Hyp - not this add-on - issues in integrated mode; the direct API settings below cover both."
msgstr "С запросом на оплату уходят только эти два параметра. CC-адрес EzCount и привязка документа к карточке клиента задаются на самом документе, а в режиме integrated его выписывает Hyp, а не этот модуль; в настройках прямого API ниже есть и то, и другое."

msgctxt "Languages::hypay_ez_customer_assoc"
msgid "Customer card"
msgstr "Карточка клиента"

msgctxt "Languages::hypay_ez_customer_assoc_label"
msgid "File the document under the customer's EzCount card"
msgstr "Привязывать документ к карточке клиента в EzCount"

msgctxt "Languages::hypay_ez_customer_assoc_desc"
msgid "Sends customerAction=ASSOC_ONLY, so EzCount attaches the document to a customer card that already matches and does not create a new one. This is what the EzCount Invoice Generator add-on does."
msgstr "Передаёт customerAction=ASSOC_ONLY: EzCount привяжет документ к уже подходящей карточке клиента и не создаст новую. Так же поступает модуль EzCount Invoice Generator."

msgctxt "Languages::hypay_ez_customer_cc_emails"
msgid "CC e-mail"
msgstr "CC-адрес"

msgctxt "Languages::hypay_ez_customer_cc_emails_label"
msgid "Send the customer's EzCount CC e-mail"
msgstr "Передавать CC-адрес клиента в EzCount"

msgctxt "Languages::hypay_ez_customer_cc_emails_desc"
msgid "Copies the document to the addresses in the customer's EzCount CC e-mail profile field. Several addresses may be separated by commas."
msgstr "Копия документа уходит на адреса из поля профиля с CC-адресом EzCount. Несколько адресов разделяются запятыми."

msgctxt "Languages::hypay_ez_cc_email_field_id"
msgid "CC e-mail profile field ID"
msgstr "ID поля профиля с CC-адресом"

msgctxt "Languages::hypay_ez_cc_email_field_id_desc"
msgid "The ID of the profile field holding the EzCount CC e-mail. Leave it empty to use the field named ezcount_additional_email, which is the one the EzCount Invoice Generator add-on reads."
msgstr "ID поля профиля, в котором хранится CC-адрес EzCount. Оставьте пустым, чтобы использовать поле с именем ezcount_additional_email - то же, которое читает модуль EzCount Invoice Generator."

