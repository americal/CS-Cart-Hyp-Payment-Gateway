msgstr "Order number only"

msgctxt "Languages::hypay_ez_line_items_mode_desc"
msgid "How a document issued at regular checkout is itemized. List products: a line per product plus shipping, payment surcharge, discounts and the rounding adjustment. Order number only: a single line reading Order #1234, priced at the order total."
msgstr "How a document issued at regular checkout is itemized. List products: a line per product plus shipping, payment surcharge, discounts and the rounding adjustment. Order number only: a single line reading Order #1234, priced at the order total."

msgctxt "Languages::hypay_ez_line_items_mode_j5"
