msgstr "EzCount document was not issued: the order lines add up to [items] but [charged] was charged. Edit the order so the totals match."

msgctxt "Languages::hypay_j5"
msgid "J5 hold"
msgstr "J5 hold"

msgctxt "Languages::hypay_j5_pi_hold_until"
