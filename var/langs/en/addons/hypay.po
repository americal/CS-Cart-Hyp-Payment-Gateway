msgstr "Let EzCount calculate installment schedule (1 = on, 0 = off)"

msgctxt "Languages::hypay_ez_auto_calc_payments_desc"
msgid "When enabled, the request sends auto_calc_payments=1 in the payment block."
msgstr "When enabled, the request sends auto_calc_payments=1 in the payment block."

# J5 (two-phase commit)
msgctxt "Languages::hypay_j5_section"
msgid "J5 / Two-phase commit"
msgstr "J5 / Two-phase commit"

msgctxt "Languages::hypay_payment_type"
msgid "Payment type"
msgstr "Payment type"

msgctxt "Languages::hypay_payment_type_desc"
msgid "Regular: the card is charged immediately. J5: the funds are only held and are charged later from the order page. By usergroup: J5 is used for the usergroups selected below, everybody else pays as usual."
msgstr "Regular: the card is charged immediately. J5: the funds are only held and are charged later from the order page. By usergroup: J5 is used for the usergroups selected below, everybody else pays as usual."

msgctxt "Languages::hypay_payment_type_regular"
msgid "Regular charge (J4)"
msgstr "Regular charge (J4)"

msgctxt "Languages::hypay_payment_type_j5"
msgid "Hold funds (J5) for everyone"
msgstr "Hold funds (J5) for everyone"

msgctxt "Languages::hypay_payment_type_usergroup"
msgid "Hold funds (J5) by usergroup"
msgstr "Hold funds (J5) by usergroup"

msgctxt "Languages::hypay_j5_usergroups"
msgid "Usergroups paying with J5"
msgstr "Usergroups paying with J5"

msgctxt "Languages::hypay_j5_usergroups_desc"
msgid "Used only when the payment type is \"Hold funds (J5) by usergroup\". A customer belonging to any of the selected groups gets a J5 authorization instead of a charge. Reset selected clears the list in the form and takes effect once the method is saved; an empty list means nobody gets a hold and every customer is charged at checkout."
msgstr "Used only when the payment type is \"Hold funds (J5) by usergroup\". A customer belonging to any of the selected groups gets a J5 authorization instead of a charge. Reset selected clears the list in the form and takes effect once the method is saved; an empty list means nobody gets a hold and every customer is charged at checkout."

msgctxt "Languages::hypay_j5_usergroups_reset"
msgid "Reset selected"
msgstr "Reset selected"

msgctxt "Languages::hypay_j5_usergroups_empty"
msgid "Usergroup list is unavailable. Save the payment method and reopen this page."
msgstr "Usergroup list is unavailable. Save the payment method and reopen this page."

msgctxt "Languages::hypay_j5_auth_status"
msgid "Order status: funds held"
msgstr "Order status: funds held"

msgctxt "Languages::hypay_j5_auth_status_desc"
msgid "Set right after a successful J5 authorization, while the money is only held."
msgstr "Set right after a successful J5 authorization, while the money is only held."

msgctxt "Languages::hypay_j5_captured_status"
msgid "Order status: captured"
msgstr "Order status: captured"

msgctxt "Languages::hypay_j5_captured_status_desc"
msgid "Set after the held amount has been charged."
msgstr "Set after the held amount has been charged."

msgctxt "Languages::hypay_j5_auth_additional_status"
msgid "Additional status: funds held"
msgstr "Additional status: funds held"

msgctxt "Languages::hypay_j5_auth_additional_status_desc"
msgid "Additional order status to mark once Hyp confirms the hold and the order takes the status above. Left at \"do not change\", only the main order status moves. Needs the [eCom Labs] Additional Order Statuses add-on: while it is disabled both of these selectors are hidden and the stored choices are kept until it comes back."
msgstr "Additional order status to mark once Hyp confirms the hold and the order takes the status above. Left at \"do not change\", only the main order status moves. Needs the [eCom Labs] Additional Order Statuses add-on: while it is disabled both of these selectors are hidden and the stored choices are kept until it comes back."

msgctxt "Languages::hypay_additional_status_none"
msgid "— do not change —"
msgstr "— do not change —"

msgctxt "Languages::hypay_j5_captured_additional_status"
msgid "Additional status: captured"
msgstr "Additional status: captured"

msgctxt "Languages::hypay_j5_captured_additional_status_desc"
msgid "Additional order status to mark once the held amount has been charged. Left at \"do not change\", only the main order status moves. Needs the [eCom Labs] Additional Order Statuses add-on: while it is disabled both of these selectors are hidden and the stored choices are kept until it comes back."
msgstr "Additional order status to mark once the held amount has been charged. Left at \"do not change\", only the main order status moves. Needs the [eCom Labs] Additional Order Statuses add-on: while it is disabled both of these selectors are hidden and the stored choices are kept until it comes back."

msgctxt "Languages::hypay_j5_void_status"
msgid "Order status: hold cancelled"
msgstr "Order status: hold cancelled"

msgctxt "Languages::hypay_j5_void_status_desc"
msgid "Set when the hold is abandoned and no money is taken."
msgstr "Set when the hold is abandoned and no money is taken."

msgctxt "Languages::hypay_j5_hold_days"
msgid "Authorization window, days"
msgstr "Authorization window, days"

msgctxt "Languages::hypay_j5_hold_days_desc"
msgid "How long the issuer keeps the funds blocked (Hyp: about 5 days). Used to show the capture deadline on the order page."
msgstr "How long the issuer keeps the funds blocked (Hyp: about 5 days). Used to show the capture deadline on the order page."

