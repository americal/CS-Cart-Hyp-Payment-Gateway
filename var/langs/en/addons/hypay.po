msgstr "Order status on failure"

msgctxt "Languages::hypay_fail_status_desc"
msgid "Select which order status to set when Hypay fails or the request can't be signed."
msgstr "Select which order status to set when Hypay fails or the request can't be signed."

msgctxt "Languages::hypay_building_field_id"
msgid "Building field ID"
msgstr "Building field ID"

msgctxt "Languages::hypay_building_field_id_desc"
msgid "Customer profile field ID that stores the building/house number. Leave empty if not used."
msgstr "Customer profile field ID that stores the building/house number. Leave empty if not used."

msgctxt "Languages::hypay_debug_mode"
msgid "Debug mode"
msgstr "Debug mode"

msgctxt "Languages::hypay_debug_mode_label"
msgid "Enable request/response logging to hypay_ezcount.log"
msgstr "Enable request/response logging to hypay_ezcount.log"

msgctxt "Languages::hypay_debug_mode_desc"
msgid "When enabled, the processor writes detailed logs to the file below. Disable on production for performance and security."
msgstr "When enabled, the processor writes detailed logs to the file below. Disable on production for performance and security."

msgctxt "Languages::hypay_ez_mode"
msgid "EzCount mode"
msgstr "EzCount mode"

msgctxt "Languages::hypay_ez_mode_none"
msgid "Disabled"
msgstr "Disabled"

msgctxt "Languages::hypay_ez_mode_integrated"
msgid "Integrated (via Hypay)"
msgstr "Integrated (via Hypay)"

msgctxt "Languages::hypay_ez_mode_direct"
msgid "Direct API"
msgstr "Direct API"

msgctxt "Languages::hypay_ez_mode_desc"
msgid "Choose how invoices are created: integrated (Hypay triggers EzCount) or direct (this add-on calls EzCount API). Choose Disabled to skip invoicing."
msgstr "Choose how invoices are created: integrated (Hypay triggers EzCount) or direct (this add-on calls EzCount API). Choose Disabled to skip invoicing."

msgctxt "Languages::hypay_ez_doc_type"
msgid "Document type"
msgstr "Document type"

msgctxt "Languages::hypay_ez_doc_type_320"
msgid "Tax Invoice Receipt"
msgstr "Tax Invoice Receipt"

msgctxt "Languages::hypay_ez_doc_type_400"
msgid "Receipt"
msgstr "Receipt"

msgctxt "Languages::hypay_ez_doc_type_desc"
msgid "320 — Tax Invoice Receipt, 400 — Receipt."
msgstr "320 — Tax Invoice Receipt, 400 — Receipt."

msgctxt "Languages::hypay_ez_created_by_api_key"
msgid "Created by API key (distributors)"
msgstr "Created by API key (distributors)"

msgctxt "Languages::hypay_ez_created_by_api_key_desc"
msgid "Optional. Use only if you create documents on behalf of multiple EZcount users. Send it as-is (do not hash). Leave empty to omit."
msgstr "Optional. Use only if you create documents on behalf of multiple EZcount users. Send it as-is (do not hash). Leave empty to omit."


msgctxt "Languages::hypay_ez_doc_lang"
msgid "Document language (lang)"
msgstr "Document language (lang)"

msgctxt "Languages::hypay_ez_doc_lang_desc"
msgid "he for Hebrew (default), en for English."
msgstr "he for Hebrew (default), en for English."

msgctxt "Languages::hypay_ez_show_items_including_vat"
msgid "Show items including VAT"
msgstr "Show items including VAT"

msgctxt "Languages::hypay_ez_show_items_including_vat_label"
msgid "Send item prices as VAT-inclusive (1 = on, 0 = off)"
msgstr "Send item prices as VAT-inclusive (1 = on, 0 = off)"

msgctxt "Languages::hypay_ez_show_items_including_vat_desc"
msgid "When enabled, the API receives show_items_including_vat=1. Disable to send 0."
msgstr "When enabled, the API receives show_items_including_vat=1. Disable to send 0."

msgctxt "Languages::hypay_ez_auto_calc_payments"
msgid "Auto-calc payments"
msgstr "Auto-calc payments"

msgctxt "Languages::hypay_ez_auto_calc_payments_label"
msgid "Let EzCount calculate installment schedule (1 = on, 0 = off)"
msgstr "Let EzCount calculate installment schedule (1 = on, 0 = off)"

msgctxt "Languages::hypay_ez_auto_calc_payments_desc"
msgid "When enabled, the request sends auto_calc_payments=1 in the payment block."
msgstr "When enabled, the request sends auto_calc_payments=1 in the payment block."
